<!--
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    &lt;!&ndash; Setting up log path and log file name &ndash;&gt;
    &lt;!&ndash;<property name="LOG_PATH" value="B:/sp-log/" />
    <property name="LOG_FILE_NAME" value="one-to-many-h2" />&ndash;&gt;
    &lt;!&ndash; Setting up logging pattern for console logging
         We can set color text logging !
         like
                                (color follow the level)       (yellow)
         2023-10-28 09:15:57,510        INFO            [http-nio-8080-exec-1] : Completed initialization in 2 ms
    &ndash;&gt;


    <appender name="ConsoleOutput"
              class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                %white(%d{ISO8601}) %highlight(%-5level) [%yellow(%t)] : %msg%n%throwable
            </Pattern>
        </layout>
    </appender>


    &lt;!&ndash; Setting the filename and logging pattern for log file &ndash;&gt;
    &lt;!&ndash;<appender name="LogFile"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>
        <encoder
                class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level : %msg%n
            </Pattern>
        </encoder>

        &lt;!&ndash; Setting up a rolling policy with rolling done
              daily and when file size is 10MB&ndash;&gt;
        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
    </appender>&ndash;&gt;


    &lt;!&ndash; Logging at INFO level &ndash;&gt;
    <root level="info">
        <appender-ref ref="ConsoleOutput" />
    </root>

    &lt;!&ndash; Logging at TRACE level &ndash;&gt;
    <logger name="com.log" level="trace" additivity="false">
        <appender-ref ref="ConsoleOutput" />
    </logger>

</configuration>-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- looks like => 22:39:23.992 [main] DEBUG c.t.server.controller.RouteControl : Hello World -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} : %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO,DEBUG">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
